# === Domain ===
DOMAIN=ndobaak.com

# === Docker Registry (AWS ECR) ===
ECR_REGISTRY=123456789.dkr.ecr.eu-central-1.amazonaws.com
TAG=latest

# === PostgreSQL ===
POSTGRES_DB=ndobaak
POSTGRES_USER=ndobaak
POSTGRES_PASSWORD=

# === JWT ===
JWT_SECRET=

# === OAuth2 Google ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === AWS S3 ===
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=eu-central-1
STORAGE_PUBLIC_URL=https://ndobaak-media.s3.eu-central-1.amazonaws.com

# === SMTP (SES, Brevo, etc.) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# === NotchPay (passerelle de paiement) ===
# PAYMENT_CALLBACK_URL et NOTCHPAY_CALLBACK_URL sont déduits de DOMAIN dans docker-compose.prod.yml
PAYMENT_GATEWAY=notchpay
NOTCHPAY_BASE_URL=https://api.notchpay.co
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_PRIVATE_KEY=
NOTCHPAY_WEBHOOK_HASH=

# === CORS ===
CORS_ORIGINS=https://ndobaak.pages.dev,https://www.ndobaak.com

# === Frontend ===
FRONTEND_URL=https://ndobaak.pages.dev

# === Twilio (SMS) ===
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
