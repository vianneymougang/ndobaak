# === Domain ===
DOMAIN=ndobaak.com

# === Docker Registry (AWS ECR) ===
ECR_REGISTRY=123456789.dkr.ecr.eu-west-3.amazonaws.com
TAG=latest

# === PostgreSQL ===
POSTGRES_DB=ndobaak
POSTGRES_USER=ndobaak
POSTGRES_PASSWORD=

# === JWT ===
JWT_SECRET=

# === OAuth2 Google ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === AWS S3 ===
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=eu-west-3
STORAGE_PUBLIC_URL=https://ndobaak-media.s3.eu-west-3.amazonaws.com

# === SMTP (SES, Brevo, etc.) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
